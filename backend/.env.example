# Copy to .env for local development. Never commit the real .env file.

# Local default is SQLite (zero setup). For production, point at Postgres, e.g.:
# postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./portfolio_risk.db

# Optional: enables the Redis-backed covariance-matrix cache (Section 2/9).
# If unset, the app falls back to an in-process cache automatically.
REDIS_URL=

# Section 5.4: risk-free rate used across Sharpe/Sortino/Treynor/Alpha (decimal, e.g. 0.065 = 6.5%).
RISK_FREE_RATE=0.065

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173

ENVIRONMENT=development
